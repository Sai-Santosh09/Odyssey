# ==========================================
# 🛑 Odyssey Master .gitignore
# ==========================================

# Dependencies & Package Managers
node_modules/
**/node_modules/
.pnp
.pnp.js
package-lock.json.bak

# Build & Output Artifacts
dist/
dist-ssr/
build/
out/
*.local
**/dist/
**/build/

# Environment Variables & Secrets (CRITICAL)
.env
.env.*
!.env.example
*.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local

# Python Artifacts & Virtual Environments
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
.installed.cfg
*.egg

# Logs & Temporary Files
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*

# Editor & IDE Configs
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Mobile & Capacitor Native Build Artifacts
.gradle/
**/android/.gradle/
**/android/app/build/
**/android/build/
*.apk
*.aab
**/ios/DerivedData/
**/ios/Pods/
*.xcworkspace
*.xcuserdatad
Podfile.lock

# Scratchpads & Antigravity Agent Temp Logs
scratch/
**/scratch/
.temp/
.tmp/
